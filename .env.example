# Supabase (public/browser-safe values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put SUPABASE_SERVICE_ROLE_KEY, Microsoft Graph secrets, outbound API
# secrets, or any other server-side credential in this file or anywhere
# under src/. Those belong in Supabase Edge Function secrets / server-side
# environment only.

# Local-only Node tooling (scripts/, never src/): npm run seed:mock-emails
# reads this from your gitignored .env.local — never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=
